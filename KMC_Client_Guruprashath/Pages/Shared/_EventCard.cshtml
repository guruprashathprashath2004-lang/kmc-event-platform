@model EventVM
@{
    var fillPercent = Model.Capacity > 0 ? (int)Math.Round(100.0 * Model.RegisteredCount / Model.Capacity) : 0;
}
<div class="event-card">
    <div class="event-thumb" style="background-image:url('@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/events/placeholder.jpg" : Model.ImageUrl)');">
        <span class="badge-category">@Model.CategoryName</span>
    </div>
    <div class="card-body">
        <div class="event-date-chip">
            <i class="bi bi-calendar-event"></i> @Model.EventDate.ToString("dd MMM yyyy") &middot; @Model.StartTime.ToString(@"hh\:mm")
        </div>
        <h3 class="event-title">@Model.Title</h3>
        <p class="text-muted-kmc small mb-3" style="min-height: 3.2em;">
            @(Model.Description.Length > 90 ? Model.Description.Substring(0, 90) + "..." : Model.Description)
        </p>
        <div class="d-flex justify-content-between align-items-center small text-muted-kmc mb-2">
            <span><i class="bi bi-geo-alt"></i> @Model.Venue</span>
            <span>@Model.SeatsLeft seats left</span>
        </div>
        <div class="seats-bar mb-3">
            <div class="seats-bar-fill" data-fill="@fillPercent"></div>
        </div>
        <div class="d-flex gap-2 mt-auto">
            <a asp-page="/Event/Details" asp-route-id="@Model.EventId" class="btn btn-neon-outline btn-sm flex-fill text-center">Details</a>
            @if (Model.SeatsLeft > 0)
            {
                <a asp-page="/Event/Register" asp-route-id="@Model.EventId" class="btn btn-neon btn-sm flex-fill text-center">Register</a>
            }
            else
            {
                <span class="btn btn-sm flex-fill text-center disabled" style="background: var(--panel-2); color: var(--text-muted);">Fully Booked</span>
            }
        </div>
    </div>
</div>
