@{
    var authName = Context.Session.GetString("AuthName");
    var authRole = Context.Session.GetString("AuthRole");
    bool isLoggedIn = !string.IsNullOrEmpty(authRole);
    string currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KMC Event Platform</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Rajdhani:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg kmc-navbar py-3">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">
                    <i class="bi bi-buildings me-1"></i>KMC<span>.</span>EVENTS
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#kmcNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="kmcNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link @(currentPage == "/Index" ? "active" : "")" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentPage == "/Event/Index" ? "active" : "")" asp-page="/Event/Index">Events</a>
                        </li>
                        @if (isLoggedIn)
                        {
                            if (authRole == "Admin")
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(currentPage == "/Admin/Index" ? "active" : "")" asp-page="/Admin/Index">Dashboard</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-page="/Admin/Approvals">Approvals</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-page="/Admin/Users">Users</a>
                                </li>
                            }
                            else if (authRole == "Organizer")
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(currentPage == "/Organizer/Index" ? "active" : "")" asp-page="/Organizer/Index">My Events</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-page="/Organizer/Create">Submit Event</a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-page="/Event/MyRegistrations">My Registrations</a>
                                </li>
                            }
                            <li class="nav-item ms-lg-2">
                                <span class="text-muted-kmc small me-2"><i class="bi bi-person-badge"></i> @authName <span class="badge rounded-pill" style="background: var(--panel-2);">@authRole</span></span>
                                <a class="btn btn-neon-outline btn-sm" asp-page="/Account/Logout">Logout</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item ms-lg-2">
                                <a class="btn btn-neon-outline btn-sm me-2" asp-page="/Account/Register">Sign Up</a>
                                <a class="btn btn-neon btn-sm" asp-page="/Account/Login">Login</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="kmc-main">
        @if (TempData["Success"] != null)
        {
            <div class="container mt-4">
                <div class="alert alert-success bg-transparent border-success text-success">
                    <i class="bi bi-check-circle me-1"></i> @TempData["Success"]
                </div>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="container mt-4">
                <div class="alert alert-danger bg-transparent border-danger text-danger">
                    <i class="bi bi-exclamation-triangle me-1"></i> @TempData["Error"]
                </div>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="kmc-footer">
        <div class="container">
            <div class="row gy-4">
                <div class="col-md-5">
                    <div class="footer-brand h5 mb-2">KMC<span style="color:var(--magenta)">.</span>EVENTS</div>
                    <p class="mb-0">The official digital events gateway of the Kandy Municipal Council — cultural pageants, community drives, sports meets and civic workshops, all in one place.</p>
                </div>
                <div class="col-md-3">
                    <div class="eyebrow mb-2">Explore</div>
                    <ul class="list-unstyled">
                        <li><a asp-page="/Index">Home</a></li>
                        <li><a asp-page="/Event/Index">All Events</a></li>
                        <li><a asp-page="/Account/Register">Create Account</a></li>
                        <li><a asp-page="/Account/Login">Login</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <div class="eyebrow mb-2">Kandy Municipal Council</div>
                    <p class="mb-1"><i class="bi bi-geo-alt"></i> Dalada Veediya, Kandy, Sri Lanka</p>
                    <p class="mb-0"><i class="bi bi-envelope"></i> events@kmc.lk.gov</p>
                </div>
            </div>
            <hr class="border-secondary my-4">
            <p class="mb-0 small">&copy; @DateTime.Now.Year Kandy Municipal Council. Built for CSE5013 Service-Oriented Computing &mdash; KMC Event Platform.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
