@page
@model KMC_Client_Guruprashath.Pages.Event.MyRegistrationsModel
@{
    ViewData["Title"] = "My Registrations";
}

<section class="container py-5">
    <div class="section-heading">
        <div>
            <div class="eyebrow">Your Account</div>
            <h1 class="h3 mb-0">My Registrations</h1>
        </div>
        <a asp-page="/Event/Index" class="btn btn-neon-outline btn-sm">Browse More Events</a>
    </div>

    @if (Model.Registrations.Any())
    {
        <div class="row g-4">
            @foreach (var reg in Model.Registrations)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="kmc-panel h-100">
                        <div class="mb-3">
                            <div class="fw-semibold">@reg.FullName</div>
                            <div class="text-muted-kmc small">Registered @reg.RegisteredOn.ToString("dd MMM yyyy")</div>
                        </div>
                        <h3 class="h6 mb-2">@reg.Event?.Title</h3>
                        <a asp-page="/Event/Details" asp-route-id="@reg.EventId" class="btn btn-neon-outline btn-sm w-100">View Event</a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-ticket-perforated fs-1 d-block mb-3"></i>
            You haven't registered for any events yet.
            <div class="mt-3"><a asp-page="/Event/Index" class="btn btn-neon">Browse Events</a></div>
        </div>
    }
</section>
