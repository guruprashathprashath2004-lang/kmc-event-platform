@page
@model KMC_Client_Guruprashath.Pages.Organizer.CreateModel
@{
    ViewData["Title"] = "Submit Event";
}

<section class="container py-5">
    <div class="eyebrow mb-2">Organizer</div>
    <h1 class="h3 mb-4">Submit a New Event</h1>
    <p class="text-muted-kmc" style="max-width:640px;">Your event will be reviewed by a KMC Admin before it appears publicly.</p>

    <div class="kmc-panel" style="max-width: 780px;">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <form method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label asp-for="EventForm.Title" class="form-label">Event Title</label>
                <input asp-for="EventForm.Title" class="form-control" placeholder="e.g. Kandy Youth Art Exhibition" />
                <span asp-validation-for="EventForm.Title" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EventForm.Description" class="form-label">Description</label>
                <textarea asp-for="EventForm.Description" class="form-control" rows="4" placeholder="Describe the event..."></textarea>
                <span asp-validation-for="EventForm.Description" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="EventForm.CategoryId" class="form-label">Category</label>
                    <select asp-for="EventForm.CategoryId" class="form-select">
                        <option value="">-- Select category --</option>
                        @foreach (var cat in Model.EventForm.Categories)
                        {
                            <option value="@cat.CategoryId">@cat.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="EventForm.Venue" class="form-label">Venue</label>
                    <input asp-for="EventForm.Venue" class="form-control" placeholder="e.g. Kandy Public Library Hall" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="EventForm.EventDate" class="form-label">Event Date</label>
                    <input asp-for="EventForm.EventDate" type="date" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="EventForm.StartTime" class="form-label">Start Time</label>
                    <input asp-for="EventForm.StartTime" type="time" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="EventForm.Capacity" class="form-label">Capacity</label>
                    <input asp-for="EventForm.Capacity" type="number" min="1" class="form-control" />
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label">Poster Image</label>
                <div class="d-flex align-items-center gap-3">
                    <img id="posterPreview" src="#" class="admin-thumb d-none" style="width:80px;height:80px;" alt="Preview" />
                    <input type="file" name="PosterImage" accept="image/*" class="form-control" data-preview="posterPreview" />
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-neon"><i class="bi bi-send-check me-1"></i> Submit for Approval</button>
                <a asp-page="/Organizer/Index" class="btn btn-neon-outline">Cancel</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
