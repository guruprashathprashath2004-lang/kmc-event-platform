@page
@model KMC_Client_Guruprashath.Pages.PrivacyModel
@{
    ViewData["Title"] = "Privacy Policy";
}

<section class="container py-5">
    <div class="eyebrow mb-2">KMC Event Platform</div>
    <h1 class="h3 mb-4">Privacy Policy</h1>
    <div class="kmc-panel">
        <p class="text-muted-kmc">
            Information collected during event registration (name, email, phone, NIC and photo) is used solely
            by the Kandy Municipal Council to manage attendance and communicate about the specific event you
            registered for. It is not shared with third parties.
        </p>
    </div>
</section>
